{
	"name": "obsidian-flow-writer",
	"version": "1.0.0",
	"description": "Forward-only distraction-free writing mode for Obsidian",
	"main": "main.js",
	"license": "MIT",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "vitest run",
		"test:watch": "vitest",
		"install-vault": "npm run build && node scripts/install-vault.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"writing",
		"distraction-free"
	],
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@types/node": "^20.12.7",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.2",
		"obsidian": "latest",
		"typescript": "^5.4.5",
		"vitest": "^1.6.0"
	}
}
